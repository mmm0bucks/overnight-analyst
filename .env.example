# Any OpenAI-compatible chat completions endpoint (tool calling required).
OVERNIGHT_LLM_BASE_URL=https://api.neuraldeep.tech/v1
OVERNIGHT_LLM_API_KEY=changeme
OVERNIGHT_LLM_MODEL=qwen3.8-27b-noreason
# Hard limits for one run
