#!/bin/sh
# Не даёт закоммитить секреты и локальные настройки (правило К10).
# Значение найденного секрета не печатается, только имя файла.

secret_pattern='(password|passwd|secret|token|api[_-]?key)[[:space:]]*[:=][[:space:]]*["'"'"']?[^[:space:]"'"'"']{6,}|BEGIN [A-Z ]*PRIVATE KEY'

staged_files=$(git diff --cached --name-only --diff-filter=ACM)
found=0

for f in $staged_files; do
  case "$f" in
    *local.env|*.keytab|*.pem)
      echo "нельзя коммитить локальный файл с секретами: $f" >&2
      found=1
      continue
      ;;
  esac
  if git diff --cached -U0 -- "$f" | grep '^+' | grep -qiE "$secret_pattern"; then
    echo "похоже на секрет в файле: $f" >&2
    found=1
  fi
done

if [ "$found" -ne 0 ]; then
  echo "коммит остановлен (К10). Уберите секрет или замените заглушкой." >&2
  exit 1
fi
