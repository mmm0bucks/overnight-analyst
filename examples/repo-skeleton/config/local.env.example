# Переменные окружения ночного агента. Значения — только в config/local.env, он не попадает в git.
# Значение задаёт владелец. Пустая переменная — не ошибка, пока не начался этап, которому она нужна (указан в скобках).

# Рабочая схема и префикс таблиц агента (К4; этап 6)
WORK_SCHEMA=
AGENT_TABLE_PREFIX=

# Jupyter: адрес сервера; токен берётся из хранилища секретов, не отсюда (этап 5)
JUPYTER_URL=

# Модель: имя профиля в адаптере, не имя модели (этап 4)
MODEL_PROFILE_LOW=
MODEL_PROFILE_HIGH=

# Корпоративный MCP веб-поиска (К1; этап 3)
WEB_SEARCH_MCP=

# Ночное окно (этап 7)
NIGHT_FROM=18:00
NIGHT_UNTIL=09:00
