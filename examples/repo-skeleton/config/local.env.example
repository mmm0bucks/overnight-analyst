# Переменные окружения ночного агента. Значения — только в config/local.env, он не попадает в git.

# Рабочая схема и префикс таблиц агента (К4)
WORK_SCHEMA=
AGENT_TABLE_PREFIX=

# Jupyter: адрес сервера; токен берётся из хранилища секретов, не отсюда
JUPYTER_URL=

# Модель: имя профиля в адаптере, не имя модели
MODEL_PROFILE_LOW=
MODEL_PROFILE_HIGH=

# Корпоративный MCP веб-поиска (К1)
WEB_SEARCH_MCP=

# Ночное окно
NIGHT_FROM=18:00
NIGHT_UNTIL=09:00
